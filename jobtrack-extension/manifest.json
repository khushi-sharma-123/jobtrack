{
  "manifest_version": 3,
  "name": "JobTrack",
  "version": "1.1.0",
  "description": "Automatically track your job applications with JobTrack.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobTrack"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extractors/siteDetector.js",
        "extractors/genericExtractor.js",
        "extractors/naukriExtractor.js",
        "extractors/indeedExtractor.js",
        "extractors/linkedinExtractor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}